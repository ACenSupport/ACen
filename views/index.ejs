            <% if (user && user.is_admin) { %>
            <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const lists = document.querySelectorAll('.sortable-list');
                    lists.forEach(list => {
                        new Sortable(list, {
                            animation: 150,
                            handle: '.drag-handle', // drag-handle 버튼을 잡고 끌 때만 이동
                            ghostClass: 'opacity-50', // 이동 중인 카드의 투명도
                            onEnd: function (evt) {
                                let items = Array.from(list.children);
                                let reorderedData = items.map((item, index) => {
                                    return {
                                        id: item.getAttribute('data-id'),
                                        order: index + 1
                                    };
                                });
                                
                                fetch('/api/bookmark/reorder', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ reorderedData })
                                }).then(res => res.json()).then(data => {
                                    if(!data.success) {
                                        alert('순서 저장에 실패했습니다: ' + data.error);
                                    }
                                }).catch(err => {
                                    alert('서버와 통신 중 오류가 발생했습니다.');
                                });
                            },
                        });
                    });
                });
            </script>
