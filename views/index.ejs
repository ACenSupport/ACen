                                <th class="p-4 font-bold text-gray-700">사번</th>
                                <th class="p-4 font-bold text-gray-700">이름</th>
                                <th class="p-4 font-bold text-gray-700">권한</th>
                                <th class="p-4 font-bold text-gray-700">비밀번호 관리</th>
                                <th class="p-4 font-bold text-gray-700">계정 삭제</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let eid in users) { let u = users[eid]; %>
                            <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                                <td class="p-4 font-medium"><%= eid %></td>
                                <td class="p-4 font-bold"><%= u.name %></td>
                                <td class="p-4"><% if (u.is_admin) { %><span class="text-blue-600 font-bold">관리자</span><% } else { %>팀원<% } %></td>
                                <td class="p-4">
                                    <div class="flex space-x-2">
                                        <form action="/admin/action" method="post" onsubmit="return confirm('비밀번호를 [new1234@]로 초기화 할까?');">
                                            <input type="hidden" name="action" value="reset">
                                            <input type="hidden" name="emp_id" value="<%= eid %>">
                                            <button type="submit" class="text-xs bg-orange-100 text-orange-700 px-3 py-1.5 rounded font-bold hover:bg-orange-200">초기화</button>
                                        </form>
                                        <button onclick="openPwModal('<%= eid %>', '<%= u.name %>')" class="text-xs bg-gray-100 text-gray-700 px-3 py-1.5 rounded font-bold hover:bg-gray-200">직접 변경</button>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <% if (!u.is_admin) { %>
                                    <form action="/admin/action" method="post" onsubmit="return confirm('<%= eid %> 삭제 하시겠습니까?');">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="emp_id" value="<%= eid %>">
                                        <button type="submit" class="text-xs bg-red-100 text-red-700 px-3 py-1.5 rounded font-bold hover:bg-red-200">삭제</button>
                                    </form>
                                    <% } else { %>
                                    <span class="text-xs text-gray-400">삭제 불가</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-8 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-xl font-bold text-gray-900 mb-4">데이터 백업 및 복구</h2>
                    <div class="flex space-x-6">
                        <div class="flex-1 bg-gray-50 p-5 rounded-xl border border-gray-200">
                            <h3 class="font-bold text-gray-800 mb-4">백업 (데이터 다운로드)</h3>
                            <a href="/admin/backup" class="inline-block bg-blue-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-blue-700 transition">데이터 백업하기 (.json)</a>
                        </div>
                        <div class="flex-1 bg-gray-50 p-5 rounded-xl border border-gray-200">
                            <h3 class="font-bold text-gray-800 mb-4">복구 (데이터 업로드)</h3>
                            <form action="/admin/restore" method="post" id="restore-form" class="space-y-3">
                                <input type="file" id="backup-file" accept=".json" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-200 file:text-gray-700 hover:file:bg-gray-300">
                                <input type="hidden" name="backup_data" id="backup_data">
                                <button type="button" onclick="submitRestore()" class="bg-red-500 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-red-600 transition">데이터 복구하기</button>
                            </form>
                        </div>
                    </div>
                </div>
                
                <script>
                    function submitRestore() {
                        const fileInput = document.getElementById('backup-file');
                        if (!fileInput.files || fileInput.files.length === 0) {
                            alert('복구할 백업 파일(.json)을 선택해 주세요.');
                            return;
                        }
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            document.getElementById('backup_data').value = e.target.result;
                            if(confirm("기존 데이터가 덮어씌워집니다. 정말 복구하시겠습니까?")) {
                                document.getElementById('restore-form').submit();
                            }
                        };
                        reader.readAsText(fileInput.files[0]);
                    }
                </script>
