                    <div>
                        <h1 class="text-3xl font-extrabold text-gray-900">ID 관리</h1>
                    </div>
                    <button onclick="document.getElementById('admin-create-user-modal').classList.remove('hidden')" class="bg-blue-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-blue-700 transition">
                        + 팀원 추가
                    </button>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8">
