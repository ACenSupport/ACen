                        </div>
                        <div class="border-t border-gray-100 pt-3 mt-2">
                            <label class="block text-sm font-bold text-gray-700 mb-1">기존 비밀번호</label>
                            <input type="password" name="current_pw" placeholder="변경 시에만 입력" class="w-full border border-gray-300 p-2 rounded-lg focus:outline-none focus:border-black bg-gray-50 mb-2">
                            <label class="block text-sm font-bold text-gray-700 mb-1">바꿀 비밀번호</label>
                            <input type="password" name="new_pw" placeholder="새 비밀번호" class="w-full border border-gray-300 p-2 rounded-lg focus:outline-none focus:border-black bg-gray-50 mb-2">
                            <label class="block text-sm font-bold text-gray-700 mb-1">비밀번호 확인</label>
                            <input type="password" name="confirm_pw" placeholder="새 비밀번호 확인" class="w-full border border-gray-300 p-2 rounded-lg focus:outline-none focus:border-black bg-gray-50">
                        </div>
                        <div class="flex justify-end space-x-2 pt-3 border-t border-gray-100">
                            <button type="button" onclick="closeProfileModal()" class="px-5 py-2.5 bg-white border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50">취소</button>
                            <button type="submit" class="px-5 py-2.5 bg-gray-900 text-white rounded-lg font-medium hover:bg-black">수정하기</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 3. 사이드바 설정 모달 -->
            <% if (user && user.is_admin) { %>
            <div id="sidebar-settings-modal" class="hidden fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-[200]">
                <div class="bg-white p-8 rounded-2xl shadow-2xl w-[400px]">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-bold text-gray-900">사이드바 설정</h3>
                        <button onclick="document.getElementById('sidebar-settings-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-900 font-bold text-xl">✕</button>
                    </div>
                    <form id="sidebar-settings-form" action="/update_sidebar" method="post" class="space-y-4">
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">팀 이름 변경</label>
                            <input type="text" name="team_name" value="<%= sidebar_info.name %>" class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">이모지 로고 (Win + .)</label>
                            <input type="text" name="sidebar_emoji" placeholder="예: 🏖️" maxlength="2" class="w-full border border-gray-300 p-2 rounded-lg focus:outline-none focus:border-black bg-gray-50">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-1">또는 이미지 업로드</label>
                            <input type="file" id="logo_file" accept="image/*" onchange="convertImage(this, 'logo_base64')" class="w-full border border-gray-300 p-2 rounded-lg focus:outline-none focus:border-black text-sm bg-gray-50">
                            <input type="hidden" id="logo_base64" name="logo_base64">
                            
                            <label class="flex items-center space-x-2 cursor-pointer mt-3">
                                <input type="checkbox" name="reset_logo" value="yes" class="w-4 h-4 text-gray-900 border-gray-300 rounded focus:ring-gray-900">
                                <span class="text-sm text-gray-600 font-medium">기본 로고로 초기화 (이미지/이모지 삭제)</span>
                            </label>
                        </div>
                        <div class="flex justify-end space-x-2 pt-4 border-t border-gray-100">
                            <button type="button" onclick="closeSidebarModal()" class="px-5 py-2.5 bg-white border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50">취소</button>
                            <button type="submit" class="px-5 py-2.5 bg-gray-900 text-white rounded-lg font-medium hover:bg-black">저장하기</button>
                        </div>
                    </form>
                </div>
            </div>
            <% } %>

            <script>
                function convertImage(input, hiddenId) {
                    if (input.files && input.files[0]) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            document.getElementById(hiddenId).value = e.target.result;
                        };
                        reader.readAsDataURL(input.files[0]);
                    }
                }
                function closeProfileModal() {
                    document.getElementById('profile-settings-modal').classList.add('hidden');
                    document.getElementById('profile-settings-form').reset();
                    document.getElementById('profile_img_base64').value = '';
                }
                function closeSidebarModal() {
                    let modal = document.getElementById('sidebar-settings-modal');
                    if(modal) modal.classList.add('hidden');
                    let form = document.getElementById('sidebar-settings-form');
                    if(form) form.reset();
                    let logo = document.getElementById('logo_base64');
                    if(logo) logo.value = '';
                }
            </script>
            
            <!-- [V37] 글로벌 툴팁 컨테이너 및 스크립트 -->
            <div id="global-tooltip" class="hidden fixed z-[9999] bg-gray-800 text-white text-xs rounded py-1.5 px-2.5 shadow-lg whitespace-pre-line text-center leading-relaxed pointer-events-none transition-opacity duration-100"></div>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const tooltip = document.getElementById('global-tooltip');
                    if(!tooltip) return;
                    
                    document.body.addEventListener('mouseover', function(e) {
                        const target = e.target.closest('.tooltip-trigger');
                        if (!target) return;
                        
                        tooltip.innerHTML = target.getAttribute('data-tooltip-html');
                        tooltip.classList.remove('hidden');
                        
                        const rect = target.getBoundingClientRect();
                        
                        // DOM 갱신 후 크기를 잡기 위해 setTimeout 사용
                        setTimeout(() => {
                            const tooltipRect = tooltip.getBoundingClientRect();
                            // 기본 위치: 요소의 아래쪽
                            let topPos = rect.bottom + 8;
                            
                            // 화면 아래로 넘어갈 경우 위쪽으로 재배치
                            if (rect.bottom + tooltipRect.height + 15 > window.innerHeight) {
                                topPos = rect.top - tooltipRect.height - 8;
                            }
                            
                            let leftPos = rect.left + (rect.width / 2) - (tooltipRect.width / 2);
                            
                            // fixed 포지션이므로 client 좌표 그대로 사용
                            tooltip.style.top = topPos + 'px';
                            tooltip.style.left = leftPos + 'px';
                        }, 0);
                    });
                    
                    document.body.addEventListener('mouseout', function(e) {
                        const target = e.target.closest('.tooltip-trigger');
                        if (!target) return;
                        tooltip.classList.add('hidden');
                    });
                });
            </script>
        </div>
    </div>
    <% } %> <!-- End of if page == 'login' -->
</body>
</html>
