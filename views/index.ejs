<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title><%= sidebar_info.name %></title>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/moonspam/NanumSquare@2.0/nanumsquare.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/ko.js"></script>

    <script>
        const globalHolidays = [
            <% if (typeof holidays !== 'undefined') { %>
                <% holidays.forEach(function(h) { %>'<%= h %>',<% }) %>
            <% } %>
        ];
    </script>
    
    <script>
        function switchTab(tab) {
            document.getElementById('form-login').classList.add('hidden');
            document.getElementById('form-signup').classList.add('hidden');
            document.getElementById('form-reset').classList.add('hidden');
            
            document.getElementById('tab-login').className = 'flex-1 pb-3 text-center font-bold text-gray-400 hover:text-gray-900 border-b-2 border-transparent';
            document.getElementById('tab-signup').className = 'flex-1 pb-3 text-center font-bold text-gray-400 hover:text-gray-900 border-b-2 border-transparent';
            
            if (tab === 'login') {
                document.getElementById('form-login').classList.remove('hidden');
                document.getElementById('tab-login').className = 'flex-1 pb-3 text-center font-bold text-gray-900 border-b-2 border-gray-900';
            } else if (tab === 'signup') {
                document.getElementById('form-signup').classList.remove('hidden');
                document.getElementById('tab-signup').className = 'flex-1 pb-3 text-center font-bold text-gray-900 border-b-2 border-gray-900';
            } else if (tab === 'reset') {
                document.getElementById('form-reset').classList.remove('hidden');
            }
        }

        async function checkDuplicateId(prefix) {
            const emp_id = document.getElementById(prefix + '-emp-id').value;
            if(!/^\d{5,6}$/.test(emp_id)) {
                alert('사번을 확인해 주세요.');
                return;
            }
            const res = await fetch('/api/check_id', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({emp_id: emp_id})
            });
            const data = await res.json();
            if(data.exists) {
                alert('이미 사용중인 사번입니다.');
                document.getElementById(prefix + '-id-checked').value = 'false';
            } else {
                alert('사용 가능한 사번입니다.');
                document.getElementById(prefix + '-id-checked').value = 'true';
            }
        }

        function validateSignup(prefix) {
            const emp_id = document.getElementById(prefix + '-emp-id').value;
            const checked = document.getElementById(prefix + '-id-checked').value;
            const pw1 = document.getElementById(prefix + '-pw').value;
            const pw2 = document.getElementById(prefix + '-pw-confirm').value;

            if(!/^\d{5,6}$/.test(emp_id)) {
                alert('사번을 확인해 주세요.');
                event.preventDefault(); return false;
            }
            if(checked !== 'true') {
                alert('사번 중복확인을 해주세요.');
                event.preventDefault(); return false;
            }
            if(pw1 !== pw2) {
                alert('비밀번호가 일치하지 않습니다.');
                event.preventDefault(); return false;
            }
            return true;
        }
    </script>
    
    <style>
        body { font-family: 'NanumSquare', sans-serif !important; }
        input[type="number"]::-webkit-outer-spin-button, input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        input[type="number"] { -moz-appearance: textfield; }
        
        td.fc-day-sun:not(.fc-day-other) a.fc-daygrid-day-number, 
        td.is-holiday:not(.fc-day-other) a.fc-daygrid-day-number { color: #ef4444 !important; font-weight: 900 !important; }
        td.fc-day-sat:not(.fc-day-other) a.fc-daygrid-day-number { color: #3b82f6 !important; font-weight: 900 !important; }

        td.fc-day-other.fc-day-sun a.fc-daygrid-day-number,
        td.fc-day-other.is-holiday a.fc-daygrid-day-number { color: rgba(239, 68, 68, 0.4) !important; font-weight: normal !important; }
        td.fc-day-other.fc-day-sat a.fc-daygrid-day-number { color: rgba(59, 130, 246, 0.4) !important; font-weight: normal !important; }

        .fc-toolbar-title { font-weight: 800 !important; transition: color 0.2s; }
        .fc-toolbar-title:hover { color: #3b82f6 !important; }

        .flatpickr-months { padding-top: 8px !important; padding-bottom: 8px !important; }
        .flatpickr-current-month {
            font-family: 'NanumSquare', sans-serif !important;
            display: flex !important; align-items: center !important; justify-content: center !important;
            gap: 5px; font-size: 1.15rem !important; padding-top: 5px !important;
        }
        .flatpickr-current-month .flatpickr-monthDropdown-months {
            font-weight: 800 !important; color: #1f2937 !important; background-color: transparent !important;
            border-radius: 8px !important; padding: 4px 8px !important; outline: none !important; cursor: pointer !important;
            appearance: none; -webkit-appearance: none;
        }
        .flatpickr-current-month .flatpickr-monthDropdown-months:hover { background-color: #f3f4f6 !important; }
        .flatpickr-current-month .numInputWrapper { width: 75px !important; border-radius: 8px !important; }
        .flatpickr-current-month .numInputWrapper:hover { background-color: #f3f4f6 !important; }
        .flatpickr-current-month input.cur-year { font-weight: 800 !important; color: #1f2937 !important; padding: 4px !important; cursor: text !important; }
        .flatpickr-current-month .numInputWrapper span.arrowUp, .flatpickr-current-month .numInputWrapper span.arrowDown { display: none !important; }

        .main-date-picker {
            background: transparent !important; border: none !important; outline: none !important; box-shadow: none !important;
            color: #1f2937 !important; font-weight: 800 !important; font-size: 1.5rem !important; cursor: pointer !important;
            text-align: center; width: 170px; caret-color: transparent;
        }
        .main-date-picker:focus, .main-date-picker:active {
            background: transparent !important; outline: none !important; box-shadow: none !important;
        }
        .main-date-picker::selection { background: transparent; }
    
        /* [V38/V39] 캘린더 등록된 복무 칸에 호버 시 손가락 포인터로 변경 */
        .fc-event { cursor: pointer !important; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">
    <% if (page === 'login') { %>
    <div class="flex items-center justify-center h-screen bg-gray-100">
        <div class="bg-white p-8 rounded-2xl shadow-xl w-96">
            <div class="flex justify-center mb-6 border-b border-gray-200">
                <button onclick="switchTab('login')" id="tab-login" class="flex-1 pb-3 text-center font-bold text-gray-900 border-b-2 border-gray-900">로그인</button>
                <button onclick="switchTab('signup')" id="tab-signup" class="flex-1 pb-3 text-center font-bold text-gray-400 hover:text-gray-900 border-b-2 border-transparent">회원가입</button>
            </div>
            
            <form id="form-login" action="/login" method="post" class="space-y-4">
                <div><input type="text" name="emp_id" placeholder="사번" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <div><input type="password" name="emp_pw" placeholder="비밀번호" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <button type="submit" class="w-full bg-gray-900 text-white p-2.5 rounded-lg hover:bg-black font-medium transition">로그인</button>
                <div class="text-right mt-2"><button type="button" onclick="switchTab('reset')" class="text-xs text-gray-500 hover:text-gray-900 underline">비밀번호를 잊으셨나요?</button></div>
            </form>

            <form id="form-signup" action="/signup" method="post" class="space-y-4 hidden" onsubmit="return validateSignup('signup')">
                <input type="hidden" id="signup-id-checked" value="false">
                <div><input type="text" name="name" placeholder="이름" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <div><input type="text" name="phone" placeholder="연락처 (예: 010-1234-5678)" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <div class="flex space-x-2">
                    <input type="text" id="signup-emp-id" name="emp_id" placeholder="사번 (5~6자리 숫자)" required class="flex-1 border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50" onchange="document.getElementById('signup-id-checked').value='false'">
                    <button type="button" onclick="checkDuplicateId('signup')" class="bg-gray-200 text-gray-700 px-4 rounded-lg font-bold hover:bg-gray-300 transition shrink-0 whitespace-nowrap text-sm">중복확인</button>
                </div>
                <div><input type="password" id="signup-pw" name="emp_pw" placeholder="비밀번호" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <div><input type="password" id="signup-pw-confirm" placeholder="비밀번호 확인" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <button type="submit" class="w-full bg-blue-600 text-white p-2.5 rounded-lg hover:bg-blue-700 font-medium transition">가입하기</button>
            </form>

            <form id="form-reset" action="/reset_pw_request" method="post" class="space-y-4 hidden">
                <div><input type="text" name="name" placeholder="이름" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <div><input type="text" name="emp_id" placeholder="사번" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <div><input type="text" name="phone" placeholder="연락처 (가입 시 등록된 번호)" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-black bg-gray-50"></div>
                <button type="submit" class="w-full bg-red-500 text-white p-2.5 rounded-lg hover:bg-red-600 font-medium transition">비밀번호 초기화</button>
                <button type="button" onclick="switchTab('login')" class="w-full mt-2 text-sm text-gray-500 hover:text-gray-900 transition">뒤로가기</button>
            </form>
        </div>
    </div>
    
    <% } else { %>
    <div class="flex h-screen overflow-hidden">
        <div class="w-64 bg-white border-r flex flex-col justify-between shrink-0">
            <div>
                <div class="p-6 flex items-center justify-between border-b border-gray-100 group">
                    <div class="flex items-center space-x-3 overflow-hidden">
                        <% if (sidebar_info.logo_url) { %>
                            <img src="<%= sidebar_info.logo_url %>" class="w-8 h-8 rounded object-cover">
                        <% } else if (sidebar_info.emoji) { %>
                            <div class="w-8 h-8 bg-gray-100 flex items-center justify-center rounded text-xl shrink-0"><%= sidebar_info.emoji %></div>
                        <% } else { %>
                            <div class="w-8 h-8 bg-gray-900 text-white flex items-center justify-center rounded font-bold text-sm shrink-0">복</div>
                        <% } %>
                        <span class="font-bold text-lg truncate" title="<%= sidebar_info.name %>"><%= sidebar_info.name %></span>
                    </div>
                    <% if (user && user.is_admin) { %>
                    <button onclick="document.getElementById('sidebar-settings-modal').classList.remove('hidden')" class="text-gray-300 hover:text-gray-700 transition" title="사이드바 설정">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
                    </button>
                    <% } %>
                </div>
                <nav class="mt-6 px-4 space-y-2">
                    <a href="/main" class="block py-2.5 px-4 rounded transition font-bold <% if (page === 'main') { %>bg-gray-100 font-extrabold text-black border-2 border-gray-900 shadow-sm<% } else { %>hover:bg-gray-50 text-gray-800<% } %>">복무 현황</a>
                    <a href="/calendar" class="block py-2.5 px-4 rounded transition font-bold <% if (page === 'calendar') { %>bg-gray-100 font-extrabold text-black border-2 border-gray-900 shadow-sm<% } else { %>hover:bg-gray-50 text-gray-800<% } %>">캘린더</a>
                    <a href="/leave_status" class="block py-2.5 px-4 rounded transition font-bold <% if (page === 'leave') { %>bg-gray-100 font-extrabold text-black border-2 border-gray-900 shadow-sm<% } else { %>hover:bg-gray-50 text-gray-800<% } %>">연차 잔여 현황</a>

                    <hr class="my-4 border-gray-200">
                    <a href="/bookmarks" class="block py-2.5 px-4 rounded transition font-semibold <% if (page === 'bookmarks') { %>bg-gray-100 text-gray-600 border-2 border-gray-400 shadow-sm<% } else { %>hover:bg-gray-50 text-gray-400 opacity-80 hover:opacity-100<% } %>">즐겨찾기</a>

                    <% if (user && user.is_admin) { %>
                    <hr class="my-4 border-gray-200">
                    <p class="px-4 text-xs font-extrabold text-gray-400 mb-2 tracking-wider">ADMINISTRATION</p>
                    <a href="/admin" class="block py-2.5 px-4 rounded transition font-bold <% if (page === 'admin') { %>bg-gray-100 font-extrabold text-black border-2 border-gray-900 shadow-sm<% } else { %>hover:bg-gray-50 text-gray-800<% } %>">팀원 ID 관리</a>
                    <% } %>
                </nav>
            </div>
            
            <div class="p-4 border-t border-gray-200 bg-gray-50">
                <div class="flex justify-between items-center w-full">
                    <div class="flex items-center space-x-3">
                        <% if (user && user.profile_img) { %>
                            <img src="<%= user.profile_img %>" class="w-8 h-8 rounded-full object-cover border border-gray-300">
                        <% } else if (user && user.emoji) { %>
                            <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-lg"><%= user.emoji %></div>
                        <% } else { %>
                            <div class="w-8 h-8 rounded-full bg-gray-300 flex items-center justify-center text-sm font-bold"><%= user.name[0] %></div>
                        <% } %>
                        <div>
                            <p class="font-bold text-sm"><%= user.name %></p>
                            <p class="text-xs text-gray-500"><% if (user && user.is_admin) { %>관리자<% } else { %>팀원<% } %></p>
                        </div>
                    </div>
                    <div class="flex items-center">
                        <button onclick="document.getElementById('profile-settings-modal').classList.remove('hidden')" class="text-gray-400 hover:text-gray-900 transition mr-3" title="계정 정보 수정">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" /></svg>
                        </button>
                        <a href="/logout" class="text-gray-400 hover:text-gray-900 text-sm font-bold">로그아웃</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto relative bg-gray-50">
            <% if (page === 'main') { %>
            <header class="bg-white p-4 border-b flex justify-center items-center space-x-4">
                <a href="/main?date=<%= prev_date %>" class="text-gray-400 hover:text-black transition" title="이전 날">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                </a>
                <input type="text" id="main-date-picker" value="<%= current_date %>" readonly class="main-date-picker">
                <a href="/main?date=<%= next_date %>" class="text-gray-400 hover:text-black transition" title="다음 날">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
            </header>
            
            <main class="p-8 max-w-6xl mx-auto">
                <div class="flex justify-between items-end mb-8">
                    <div>
                        <h1 class="text-3xl font-extrabold text-gray-900">복무 현황</h1>
                        <p class="text-sm text-gray-500 mt-2 font-bold"><%= Number(current_date.split('-')[1]) %>월 기준 영업일: <span class="text-blue-600"><%= current_month_biz_days %>일</span></p>
                    </div>
                </div>

                <div class="grid grid-cols-4 gap-4 mb-8">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                        <p class="text-xs text-gray-500 mb-2 font-medium">전체 팀원</p>
                        <p class="text-2xl font-bold"><%= total_members %>명</p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                        <p class="text-xs text-gray-500 mb-2 font-medium">근무 인원</p>
                        <p class="text-2xl font-bold text-green-600"><%= working_cnt %>명</p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                        <p class="text-xs text-gray-500 mb-2 font-medium">휴가 인원</p>
                        <p class="text-2xl font-bold text-orange-500"><%= leave_cnt %>명</p>
                    </div>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                        <p class="text-xs text-gray-500 mb-2 font-medium">출장 인원</p>
                        <p class="text-2xl font-bold text-blue-600"><%= trip_cnt %>명</p>
                    </div>
                </div>
                
                <div class="grid grid-cols-4 gap-4 mb-8">
                    <% team_status.forEach(function(item) { %>
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full">
                        <div class="flex justify-between items-start">
                            <div class="flex items-center space-x-3">
                                <% if (item.profile_img) { %>
                                    <img src="<%= item.profile_img %>" class="w-10 h-10 rounded-full object-cover border border-gray-200">
                                <% } else if (item.emoji) { %>
                                    <div class="w-10 h-10 rounded-full bg-gray-50 border border-gray-200 flex items-center justify-center text-xl"><%= item.emoji %></div>
                                <% } else { %>
                                    <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center font-bold text-gray-700 text-lg"><%= item.name[0] %></div>
                                <% } %>
                                <div><p class="font-bold text-gray-900"><%= item.name %></p></div>
                            </div>
                            <%
                                let bgClass = "bg-gray-50 text-gray-600 border-gray-100";
                                if (item.reason === '정상근무') bgClass = "bg-green-50 text-green-600 border-green-100";
                                else if (item.reason === '연차') bgClass = "bg-purple-50 text-purple-600 border-purple-100";
                                else if (item.reason.includes('반차')) bgClass = "bg-orange-50 text-orange-600 border-orange-100";
                                else if (item.reason === '출장') bgClass = "bg-blue-50 text-blue-600 border-blue-100";
                                else if (['공가', '장기근속휴가', '청원휴가'].includes(item.reason)) bgClass = "bg-pink-50 text-pink-600 border-pink-100";
                            %>
                            <span class="px-2.5 py-1 text-xs font-bold rounded-md border <%= bgClass %>"><%= item.reason %></span>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </main>
            <script>
                const fpConfigMain = {
                    locale: "ko",
                    dateFormat: "Y-m-d",
                    onDayCreate: function(dObj, dStr, fp, dayElem) {
                        let d = dayElem.dateObj;
                        let dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                        let isOutMonth = dayElem.classList.contains('prevMonthDay') || dayElem.classList.contains('nextMonthDay');
                        
                        if (d.getDay() === 0 || globalHolidays.includes(dateStr)) {
                            dayElem.style.color = isOutMonth ? 'rgba(239, 68, 68, 0.4)' : '#ef4444';
                            dayElem.style.fontWeight = isOutMonth ? 'normal' : 'bold';
                        } else if (d.getDay() === 6) {
                            dayElem.style.color = isOutMonth ? 'rgba(59, 130, 246, 0.4)' : '#3b82f6';
                            dayElem.style.fontWeight = isOutMonth ? 'normal' : 'bold';
                        }
                    }
                };
                if(document.getElementById("main-date-picker")) {
                    flatpickr("#main-date-picker", Object.assign({}, fpConfigMain, {
                        disableMobile: "true",
                        onChange: function(selectedDates, dateStr) {
                            window.location.href = '/main?date=' + dateStr;
                        }
                    }));
                }
            </script>

            <% } else if (page === 'calendar') { %>
            <script>
                let calendar;
                let currentPickerYear = new Date().getFullYear();

                function toggleMonthPicker(event) {
                    const picker = document.getElementById('custom-month-picker');
                    if (picker.classList.contains('hidden')) {
                        picker.classList.remove('hidden');
                        const titleRect = event.target.getBoundingClientRect();
                        picker.style.top = (titleRect.bottom + 5) + 'px';
                        picker.style.left = (titleRect.left + (titleRect.width / 2) - 125) + 'px'; 
                    } else {
                        picker.classList.add('hidden');
                    }
                }

                function changePickerYear(delta) {
                    currentPickerYear += delta;
                    document.getElementById('picker-year').innerText = currentPickerYear;
                }

                function selectMonth(month) {
                    let monthStr = String(month).padStart(2, '0');
                    let targetDate = currentPickerYear + '-' + monthStr + '-01';
                    calendar.gotoDate(targetDate);
                    document.getElementById('custom-month-picker').classList.add('hidden');
                }
                
                document.addEventListener('click', function(e) {
                    const picker = document.getElementById('custom-month-picker');
                    if (picker && !picker.classList.contains('hidden')) {
                        if (!picker.contains(e.target) && !e.target.classList.contains('fc-toolbar-title')) {
                            picker.classList.add('hidden');
                        }
                    }
                });
            </script>

            <main class="p-8 max-w-[1400px] w-full mx-auto relative">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 relative">
                    <div id="calendar"></div>
                </div>

                <div id="custom-month-picker" class="hidden fixed bg-white shadow-[0_10px_40px_rgba(0,0,0,0.1)] rounded-3xl border border-gray-100 p-5 z-[150] w-[260px] transform transition-all">
                    <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-100/50">
                        <button type="button" onclick="changePickerYear(-1)" class="text-gray-400 hover:text-gray-800 hover:bg-gray-50 w-8 h-8 rounded-full flex items-center justify-center transition duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                        </button>
                        <span id="picker-year" class="font-extrabold text-xl text-gray-800 tracking-tight"></span>
                        <button type="button" onclick="changePickerYear(1)" class="text-gray-400 hover:text-gray-800 hover:bg-gray-50 w-8 h-8 rounded-full flex items-center justify-center transition duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                        </button>
                    </div>
                    <div class="flex justify-between space-x-3 text-center font-bold text-[0.95rem]">
                        <div class="flex flex-col flex-1 space-y-1.5">
                            <% for(let i=1; i<=6; i++) { %>
                                <button type="button" onclick="selectMonth(<%= i %>)" class="py-2.5 rounded-xl text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition duration-200"><%= i %>월</button>
                            <% } %>
                        </div>
                        <div class="flex flex-col flex-1 space-y-1.5">
                            <% for(let i=7; i<=12; i++) { %>
                                <button type="button" onclick="selectMonth(<%= i %>)" class="py-2.5 rounded-xl text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition duration-200"><%= i %>월</button>
                            <% } %>
                        </div>
                    </div>
                </div>

                <script>
                    function openNewModal(dateStr) {
                        document.getElementById('modal-record-ids').value = '';
                        document.getElementById('modal-title').innerText = '복무 기록 등록';
                        document.getElementById('btn-delete').classList.add('hidden');
                        document.getElementById('btn-update').classList.add('hidden');
                        document.getElementById('btn-register').classList.remove('hidden');
                        
                        let memberSelect = document.querySelector('select[name="member"]');
                        if (memberSelect) {
                            memberSelect.disabled = false;
                            let tempOpt = document.getElementById('temp-grouped-opt');
                            if(tempOpt) tempOpt.remove();
                            let currentUserName = "<%= user.name %>";
                            memberSelect.value = currentUserName;
                        }
                        
                        let reasonSelect = document.querySelector('select[name="reason"]');
                        if(reasonSelect) reasonSelect.disabled = false;
                        
                        document.getElementById('modal-start-date')._flatpickr.setDate(dateStr);
                        document.getElementById('modal-end-date')._flatpickr.setDate(dateStr);
                        
                        document.getElementById('modal').classList.remove('hidden');
                    }

                    function openEditModal(event, dateStr) {
                        document.getElementById('modal-record-ids').value = event.id;
                        
                        let props = event.extendedProps;
                        let isGrouped = props.name.includes(',');
                        
                        document.getElementById('modal-title').innerText = isGrouped ? '그룹 복무 기록 (수정 불가)' : '복무 기록 수정';
                        document.getElementById('btn-register').classList.add('hidden');
                        document.getElementById('btn-delete').classList.remove('hidden');
                        
                        if(isGrouped) {
                            document.getElementById('btn-update').classList.add('hidden');
                        } else {
                            document.getElementById('btn-update').classList.remove('hidden');
                        }
                        
                        let memberSelect = document.querySelector('select[name="member"]');
                        if(memberSelect) {
                            memberSelect.disabled = false;
                            let tempOpt = document.getElementById('temp-grouped-opt');
                            if(tempOpt) tempOpt.remove();

                            if (isGrouped) {
                                let opt = document.createElement('option');
                                opt.value = props.name;
                                opt.text = props.name;
                                opt.id = 'temp-grouped-opt';
                                memberSelect.appendChild(opt);
                                memberSelect.value = props.name;
                                memberSelect.disabled = true;
                            } else {
                                memberSelect.value = props.name;
                            }
                        }
                        
                        let reasonSelect = document.querySelector('select[name="reason"]');
                        if(reasonSelect) {
                            reasonSelect.disabled = isGrouped;
                            reasonSelect.value = props.reason;
                        }
                        
                        document.getElementById('modal-start-date')._flatpickr.setDate(props.orig_start);
                        document.getElementById('modal-end-date')._flatpickr.setDate(props.orig_end);
                        
                        document.getElementById('modal').classList.remove('hidden');
                    }

                    function deleteEvent() {
                        let ids = document.getElementById('modal-record-ids').value;
                        let currentMonth = document.getElementById('current_calendar_date').value;
                        if(confirm("정말 이 복무 기록을 삭제하시겠습니까?")) {
                            window.location.href = '/delete/' + ids + '?date=' + currentMonth;
                        }
                    }

                    function closeModal() {
                        document.getElementById('modal').classList.add('hidden');
                    }

                    document.addEventListener('DOMContentLoaded', function() {
                        var calendarEl = document.getElementById('calendar');
                        
                        const fpConfigModal = {
                            locale: "ko",
                            dateFormat: "Y-m-d",
                            onDayCreate: function(dObj, dStr, fp, dayElem) {
                                let d = dayElem.dateObj;
                                let dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                                let isOutMonth = dayElem.classList.contains('prevMonthDay') || dayElem.classList.contains('nextMonthDay');
                                
                                if (d.getDay() === 0 || globalHolidays.includes(dateStr)) {
                                    dayElem.style.color = isOutMonth ? 'rgba(239, 68, 68, 0.4)' : '#ef4444';
                                    dayElem.style.fontWeight = isOutMonth ? 'normal' : 'bold';
                                } else if (d.getDay() === 6) {
                                    dayElem.style.color = isOutMonth ? 'rgba(59, 130, 246, 0.4)' : '#3b82f6';
                                    dayElem.style.fontWeight = isOutMonth ? 'normal' : 'bold';
                                }
                            }
                        };
                        
                        if(document.getElementById("modal-start-date")) {
                            flatpickr("#modal-start-date", fpConfigModal);
                            flatpickr("#modal-end-date", fpConfigModal);
                        }

                        calendar = new FullCalendar.Calendar(calendarEl, {
                            initialView: 'dayGridMonth',
                            initialDate: '<%= current_date %>',
                            height: 850, 
                            titleFormat: function(date) {
                                return date.date.year + '.' + String(date.date.month + 1).padStart(2, '0');
                            },
                            events: [
                                <% records.forEach(function(r) { %>
                                {
                                    id: '<%= r.id %>',
                                    title: '<%= r.name %> <%= r.reason %>', 
                                    start: '<%= r.start_date %>',
                                    end: '<%= r.end_date_fc %>', 
                                    color: getColor('<%= r.reason %>'),
                                    extendedProps: {
                                        name: '<%= r.name %>',
                                        reason: '<%= r.reason %>',
                                        orig_start: '<%= r.start_date %>',
                                        orig_end: '<%= r.end_date %>'
                                    }
                                },
                                <% }) %>
                            ],
                            dateClick: function(info) {
                                openNewModal(info.dateStr);
                            },
                            eventClick: function(info) {
                                let isAdmin = <%= user && user.is_admin ? 'true' : 'false' %>;
                                let currentUserName = "<%= user.name %>";
                                let isGrouped = info.event.extendedProps.name.includes(',');
                                
                                if (isGrouped) {
                                    if (!isAdmin) {
                                        alert('여러 명의 일정이 묶인 그룹 항목은 관리자만 삭제할 수 있습니다.\n개별 수정/삭제가 필요하다면 관리자에게 문의하세요.');
                                        return;
                                    }
                                    openEditModal(info.event, info.dateStr);
                                    return;
                                }

                                if (!isAdmin && info.event.extendedProps.name !== currentUserName) {
                                    alert('타인의 복무는 수정/취소할 수 없습니다.');
                                    return;
                                }

                                if(confirm("수정하시겠습니까?")) {
                                    openEditModal(info.event, info.dateStr);
                                }
                            },
                            datesSet: function(info) {
                                let cd = calendar.getDate();
                                currentPickerYear = cd.getFullYear();
                                let py = document.getElementById('picker-year');
                                if(py) py.innerText = currentPickerYear;

                                let currentMonth = cd.getFullYear() + '-' + String(cd.getMonth() + 1).padStart(2, '0') + '-01';
                                let hiddenInput = document.getElementById('current_calendar_date');
                                if (hiddenInput) hiddenInput.value = currentMonth;

                                let titleEl = document.querySelector('.fc-toolbar-title');
                                if (titleEl) {
                                    titleEl.style.cursor = 'pointer';
                                    titleEl.title = '클릭하여 월 선택';
                                    titleEl.onclick = function(e) { toggleMonthPicker(e); };
                                }
                            },
                            dayCellDidMount: function(arg) {
                                let d = arg.date;
                                let dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                                
                                if(globalHolidays.includes(dateStr)) {
                                    arg.el.classList.add('is-holiday');
                                    let aTag = arg.el.querySelector('.fc-daygrid-day-number');
                                    if(aTag) {
                                        aTag.style.setProperty('color', '#ef4444', 'important');
                                        aTag.style.setProperty('font-weight', '900', 'important');
                                    }
                                }
                            }
                        });
                        calendar.render();
                    });

                    function getColor(reason) {
                        if (reason === '연차') return '#a855f7';
                        if (reason.includes('반차')) return '#f97316';
                        if (reason === '출장') return '#3b82f6';
                        if (['공가', '장기근속휴가', '청원휴가'].includes(reason)) return '#ec4899';
                        return '#10b981';
                    }
                </script>
            </main>

            <% } else if (page === 'leave') { %>
            <header class="bg-white p-4 border-b flex justify-center items-center">
                <span class="text-gray-800 font-bold text-xl">연차 잔여 현황</span>
            </header>
            
            <main class="p-8 max-w-6xl mx-auto">
                <div class="flex justify-between items-end mb-8">
                    <div>
                        <h1 class="text-3xl font-extrabold text-gray-900">연차 현황</h1>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-12">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-100">
                                <th class="p-4 font-bold text-gray-700">이름</th>
                                <th class="p-4 font-bold text-gray-700">부여된 연차</th>
                                <th class="p-4 font-bold text-gray-700 w-1/3">연차 소진율 (목표 80%)</th>
                                <th class="p-4 font-bold text-gray-700">사용한 연차</th>
                                <th class="p-4 font-bold text-gray-700">잔여 연차</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% leave_data_list.forEach(function(l) { %>
                            <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                                <td class="p-4 font-medium"><%= l.name %></td>
                                <td class="p-4">
                                    <% if (user && user.is_admin) { %>
                                    <form action="/update_leave" method="post" class="flex items-center space-x-2">
                                        <input type="hidden" name="emp_id" value="<%= l.eid %>">
                                        <input type="number" name="granted" value="<%= l.granted %>" class="w-20 border border-gray-300 rounded p-1.5 text-center focus:border-black outline-none" step="0.5">
                                        <button type="submit" class="text-sm bg-gray-200 hover:bg-gray-300 px-3 py-1.5 rounded font-medium transition">수정</button>
                                    </form>
                                    <% } else { %>
                                    <span class="p-2"><%= l.granted %></span>
                                    <% } %>
                                </td>
                                <td class="p-4 pb-6">
                                    <% 
                                        let pct = l.granted > 0 ? (l.used / l.granted) * 100 : 0;
                                        let barPct = pct > 100 ? 100 : pct;
                                        let barColor = pct >= 80 ? 'bg-green-500' : 'bg-blue-500';
                                        let target80 = l.granted * 0.8;
                                        let remainTo80 = target80 - l.used;
                                        let barTooltip = remainTo80 > 0 ? `80% 소진까지 <span class='text-blue-300 font-bold'>${remainTo80.toFixed(1)}일</span> 남았습니다.` : `목표 80%를 달성했습니다! 🎉`;
                                    %>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-xs font-bold text-gray-600">진행률</span>
                                    </div>
                                    <div class="relative w-full h-5 bg-gray-200 rounded overflow-hidden shadow-inner tooltip-trigger cursor-default" data-tooltip-html="<%= barTooltip %>">
                                        <div class="absolute top-0 left-0 h-full <%= barColor %> transition-all duration-500" style="width: <%= barPct %>%;"></div>
                                        <div class="absolute top-0 h-full border-r-2 border-red-500 z-10" style="left: 80%;"></div>
                                        <div class="absolute inset-0 flex items-center justify-center z-20">
                                            <span class="text-xs font-extrabold text-white" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.5);"><%= pct.toFixed(1) %>%</span>
                                        </div>
                                    </div>
                                    <div class="relative w-full mt-1 h-4">
                                        <span class="absolute top-0 text-xs font-bold text-red-500" style="left: 80%; transform: translateX(-50%);">80%</span>
                                    </div>
                                </td>
                                <td class="p-4 font-medium text-gray-600"><%= l.used %></td>
                                <td class="p-4 font-bold text-blue-600 text-lg"><%= l.remaining %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div>
                    <div class="flex justify-between items-end mb-4">
                        <h2 class="text-2xl font-extrabold text-gray-900">월별 연차 사용 내역</h2>
                        <p class="text-sm text-gray-500">연차, 오전반차, 오후반차 합산 내역 <span class="font-bold text-blue-600">(숫자에 마우스를 올리면 사용 일자가 표시됩니다)</span></p>
                    </div>
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-x-auto pb-4">
                        <table class="w-full text-center border-collapse whitespace-nowrap">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-100">
                                    <th class="p-3 font-bold text-gray-700 text-left">이름</th>
                                    <% for(let i=1; i<=12; i++) { %>
                                        <th class="p-3 font-bold text-gray-700"><%= i %>월</th>
                                    <% } %>
                                    <th class="p-3 font-bold text-gray-900 bg-gray-100">총합</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% monthly_data_for_view.forEach(function(item) { %>
                                <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                                    <td class="p-3 font-medium text-left pl-4"><%= item.name %></td>
                                    <% let total = 0; for(let i=1; i<=12; i++) { total += item.usage[i]; %>
                                        <td class="p-3 text-gray-600">
                                            <% if (item.usage[i] > 0) { %>
                                                <div class="inline-block tooltip-trigger cursor-default" data-tooltip-html="<%= item.dates[i].join('<br>') %>">
                                                    <span class="border-b border-solid border-gray-300 pb-0.5 font-bold text-gray-900"><%= item.usage[i] %></span>
                                                </div>
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                    <% } %>
                                    <td class="p-3 font-bold text-blue-600 bg-gray-50"><%= total %></td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            
            <% } else if (page === 'bookmarks') { %>
            <header class="bg-white p-4 border-b flex justify-between items-center shadow-sm">
                <span class="text-gray-800 font-bold text-xl ml-4">즐겨찾기</span>
                <% if (user && user.is_admin) { %>
                <div class="mr-4">
                    <button onclick="openBmAddModal()" class="bg-blue-600 text-white px-5 py-2 rounded-lg font-bold hover:bg-blue-700 transition shadow-sm text-sm">
                        + 즐겨찾기 추가
                    </button>
                </div>
                <% } %>
            </header>

            <main class="p-8 max-w-6xl mx-auto h-[calc(100vh-73px)] overflow-y-auto custom-scrollbar">
                <% 
                    let groupedBms = {};
                    if(typeof bookmarks !== 'undefined') {
                        bookmarks.forEach(bm => {
                            if(!groupedBms[bm.category]) groupedBms[bm.category] = [];
                            groupedBms[bm.category].push(bm);
                        });
                    }
                    const categories = Object.keys(groupedBms).sort();
                %>
                
                <% if (categories.length === 0) { %>
                    <div class="p-12 text-gray-400 font-bold text-center bg-white rounded-2xl shadow-sm border border-gray-100 mt-8 flex flex-col items-center justify-center space-y-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                        </svg>
                        <span>등록된 즐겨찾기가 없습니다.</span>
                    </div>
                <% } else { %>
                    <% categories.forEach(cat => { %>
                        <div class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                            <div class="flex items-center mb-6 border-b border-gray-100 pb-3">
                                <span class="text-2xl font-extrabold text-gray-900 tracking-tight"><%= cat %></span>
                                <span class="ml-3 px-2 py-0.5 bg-gray-100 text-gray-500 rounded text-xs font-bold"><%= groupedBms[cat].length %></span>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 sortable-list">
                                <% groupedBms[cat].forEach(bm => { %>
                                    <div class="bg-gray-50 p-5 rounded-2xl border border-gray-200 hover:border-blue-300 hover:shadow-md transition relative group flex flex-col h-32 cursor-pointer" data-id="<%= bm.id %>" onclick="window.open('<%= bm.url %>', '_blank')">
                                        <div class="flex flex-col flex-1 h-full">
                                            <div class="flex items-center space-x-2 mb-2 pr-6">
                                                <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-blue-600 font-bold shrink-0 shadow-sm">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                                                </div>
                                                <h3 class="font-bold text-[1.05rem] text-gray-800 truncate"><%= bm.title %></h3>
                                            </div>
                                            <p class="text-xs text-gray-400 truncate mt-auto"><%= bm.url %></p>
                                        </div>
                                        
                                        <% if (user && user.is_admin) { %>
                                        <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 flex space-x-1.5 transition-opacity duration-200" onclick="event.stopPropagation();">
                                            <button class="drag-handle cursor-move p-2 bg-white rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-800 transition shadow-sm border border-gray-200" title="드래그하여 순서 변경">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" /></svg>
                                            </button>
                                            <button onclick="openBmEditModal('<%= bm.id %>', '<%= bm.category.replace(/'/g, "\\'") %>', '<%= bm.title.replace(/'/g, "\\'") %>', '<%= bm.url.replace(/'/g, "\\'") %>', <%= bm.order || 0 %>)" class="p-2 bg-white rounded-lg text-gray-600 hover:bg-blue-100 hover:text-blue-600 transition shadow-sm border border-gray-200" title="수정">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                            </button>
                                            <button onclick="if(confirm('이 즐겨찾기를 삭제하시겠습니까?')) location.href='/admin/bookmark/delete/<%= bm.id %>'" class="p-2 bg-white rounded-lg text-gray-600 hover:bg-red-100 hover:text-red-600 transition shadow-sm border border-gray-200" title="삭제">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
